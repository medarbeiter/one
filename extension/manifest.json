{
  "manifest_version": 3,
  "name": "MedArbeiter One – Formular bauen",
  "version": "0.1.0",
  "description": "Tippt eine Lead-Formular-Vorlage aus /campaigns/new im Meta-Baukasten ab.",
  "permissions": ["storage"],
  "host_permissions": ["https://business.facebook.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "Formular bauen" },
  "content_scripts": [
    {
      "matches": ["https://business.facebook.com/latest/instant_forms*"],
      "js": ["capture.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://business.facebook.com/latest/instant_forms*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
