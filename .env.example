# Meta – MedArbeiter
META_BUSINESS_ID=
META_APP_ID=
META_APP_SECRET=
# Meta-Webhook (Kommentare/DMs in Echtzeit) – frei wählbarer String, dient nur
# dazu, Metas Challenge-Aufruf beim Einrichten zu bestätigen.
META_WEBHOOK_VERIFY_TOKEN=
# Optional: Standard ist /data/inbox.sqlite (Docker-Volume). Lokal reicht die Vorgabe.
INBOX_DB_PATH=

# Fehlt noch – siehe README.md ("Token besorgen")
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
# Optional: Standard ist v26.0; die System-User-ID wird sonst aus dem Token gelesen.
META_API_VERSION=v26.0
META_SYSTEM_USER_ID=

# Anmelden über MedArbeiter – Registrierung im Hub unter /apps ("Verbundene Apps").
# Das Client-Secret zeigt der Hub genau einmal; verloren heißt erneuern.
MEDARBEITER_URL=https://hub.med-arbeiter.de
MEDARBEITER_CLIENT_ID=
MEDARBEITER_CLIENT_SECRET=
# Byte-identisch zur im Hub registrierten Rücksprung-URL.
MEDARBEITER_REDIRECT_URI=https://…/anmelden/rueckkehr
# Signiert den Sitzungs-Cookie: openssl rand -base64 32
SESSION_SECRET=
