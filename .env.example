# Meta – MedArbeiter
META_BUSINESS_ID=
META_APP_ID=
META_APP_SECRET=
# Meta-Webhook (Kommentare/DMs in Echtzeit) – frei wählbarer String, dient nur
# dazu, Metas Challenge-Aufruf beim Einrichten zu bestätigen.
META_WEBHOOK_VERIFY_TOKEN=
# Die öffentliche Adresse dieser Route. Gesetzt, meldet die App das Abonnement
# beim Start selbst an; leer bleibt der Echtzeitweg zu (lokal der Normalfall).
META_WEBHOOK_CALLBACK_URL=https://…/api/webhooks/meta
# Optional: Standard ist /data/inbox.sqlite (Docker-Volume). Lokal reicht die Vorgabe.
INBOX_DB_PATH=

# Profilbilder, letzte Stufe: Instagrams eigene Web-Route statt der Graph-API.
# Sie erreicht auch private Konten, steht aber nicht in Metas API-Bedingungen –
# deshalb standardmäßig aus (Abwägung in README.md). Ohne angemeldete Sitzung
# und ohne Proxy weist Instagram Anfragen aus einem Rechenzentrum schnell ab.
IG_SCRAPE_AVATARS=0
IG_SCRAPE_COOKIE=
IG_SCRAPE_PROXY=
IG_SCRAPE_MAX=25

# Fehlt noch – siehe README.md ("Token besorgen")
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
# Optional: Standard ist v26.0; die System-User-ID wird sonst aus dem Token gelesen.
META_API_VERSION=v26.0
META_SYSTEM_USER_ID=

# Primärtexte per KI im Kampagnen-Assistenten (lib/bodies.ts)
MISTRAL_API_KEY=

# Anmelden über MedArbeiter – Registrierung im Hub unter /apps ("Verbundene Apps").
# Das Client-Secret zeigt der Hub genau einmal; verloren heißt erneuern.
MEDARBEITER_URL=https://hub.med-arbeiter.de
MEDARBEITER_CLIENT_ID=
MEDARBEITER_CLIENT_SECRET=
# Byte-identisch zur im Hub registrierten Rücksprung-URL.
MEDARBEITER_REDIRECT_URI=https://…/anmelden/rueckkehr
# Signiert den Sitzungs-Cookie: openssl rand -base64 32
SESSION_SECRET=

# Google Drive – UGC-Videos aus dem Kundenordner (lib/drive.ts). Schlüssel-JSON des
# Dienstkontos als eine Zeile; der Kundenordner ist mit dessen E-Mail geteilt.
GOOGLE_SERVICE_ACCOUNT_KEY=
